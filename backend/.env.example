ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg://servicehub:servicehub@postgres:5432/servicehub

REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/1

SECRET_KEY=change-me-for-local-development

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=DEBUG

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REGISTRATION_REQUESTS_PER_MINUTE=5
RATE_LIMIT_LOGIN_REQUESTS_PER_MINUTE=5
RATE_LIMIT_REFRESH_REQUESTS_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60